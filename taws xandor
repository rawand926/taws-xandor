<!DOCTYPE html>
<html lang="ku">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>بەخێربێیت تاوس خان ❤️</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #ff758c, #ff7eb3, #c471ed);
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  direction: rtl;
}

.card {
  width: 90%;
  max-width: 420px;
  padding: 35px 25px;
  text-align: center;
  background: rgba(255,255,255,0.18);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.35);
  border-radius: 30px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.25);
  color: white;
}

.heart {
  font-size: 65px;
  animation: beat 1s infinite;
}

h1 {
  font-size: 30px;
  margin: 10px 0 15px;
}

p {
  font-size: 19px;
  line-height: 2;
}

button {
  border: none;
  padding: 15px 30px;
  border-radius: 50px;
  background: white;
  color: #e84375;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  transition: 0.3s;
}

button:hover {
  transform: scale(1.08);
}

#message {
  display: none;
  margin-top: 25px;
  animation: appear 1s ease;
}

.flower {
  font-size: 40px;
  margin-top: 15px;
}

.floating {
  position: fixed;
  bottom: -50px;
  font-size: 25px;
  animation: floatUp 7s linear infinite;
  opacity: 0.8;
}

@keyframes beat {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes floatUp {
  from {
    transform: translateY(0) rotate(0deg);
    opacity: 0;
  }
  20% { opacity: 1; }
  to {
    transform: translateY(-110vh) rotate(360deg);
    opacity: 0;
  }
}
</style>
</head>

<body>

<div class="card">

  <div class="heart">❤️</div>

  <h1>بەخێربێیت تاوس خان 🌹</h1>

  <p>
    ئەم پەیجە تەنها بۆ تۆیە ❤️
    <br>
    کلیک لە خوارەوە بکە بۆ ئەوەی پەیامەکەت ببینیت ✨
  </p>

  <button onclick="showMessage()">
    کلیک لێرە بکە ❤️
  </button>

  <div id="message">
    <p>
      ئەوەندە خۆشم دەوێیت ❤️🥹
      <br><br>
      ئەگەر باوکت تۆ با، بە من خوا لە هەموو شتەکانی خۆش دەبێت
      و دەیکاتە بەهەشتەوە 🤍
      <br><br>
      تۆ جوانترین بەشی دنیامی 🌹
      <br>
      دڵم تەنها بۆ تۆ لێدەدات ❤️
    </p>

    <div class="flower">🌹🌷🌹</div>
  </div>

</div>

<script>
function showMessage() {
  document.getElementById("message").style.display = "block";

  for (let i = 0; i < 20; i++) {
    let heart = document.createElement("div");
    heart.className = "floating";
    heart.innerHTML = Math.random() > 0.5 ? "❤️" : "🌹";

    heart.style.left = Math.random() * 100 + "vw";
    heart.style.animationDelay = Math.random() * 2 + "s";

    document.body.appendChild(heart);

    setTimeout(() => {
      heart.remove();
    }, 8000);
  }
}
</script>

</body>
</html>
